# Public "proof of learning" record sharing (server-side)
# MIRROR_API_URL — backend base (defaults to http://localhost:4000/api/v1)
# MIRROR_SERVICE_TOKEN — privileged token the /api/record/public route uses to read records
# RECORD_SHARE_SECRET — HMAC secret for signing/verifying public record share links (required for sharing)
MIRROR_API_URL=
MIRROR_SERVICE_TOKEN=
RECORD_SHARE_SECRET=